{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Expo Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///src/*": "${workspaceFolder}/*",
        "webpack:///app/*": "${workspaceFolder}/app/*"
      },
      "runtimeArgs": ["--disable-web-security"],
      "preLaunchTask": "expo-web"
    },
    {
      "name": "Attach to Chrome (Expo Web)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "url": "http://localhost:8081",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///app/*": "${workspaceFolder}/app/*"
      }
    },
    {
      "name": "Debug TypeScript API Files",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        "TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.json",
        "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\",\"target\":\"es2017\",\"sourceMap\":true}",
        "NODE_OPTIONS": "--loader=ts-node/esm"
      },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Debug Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/debug-test.ts",
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        "TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.json",
        "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\",\"target\":\"es2017\",\"sourceMap\":true}"
      },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
